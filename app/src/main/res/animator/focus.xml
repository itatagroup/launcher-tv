<?xml version="1.0" encoding="utf-8"?>
<!-- La app con el foco crece un poco. Solo se anima la escala (no el tamaño real): nada se recoloca. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <set>
      <objectAnimator android:propertyName="scaleX" android:valueTo="1.08" android:duration="140" android:valueType="floatType"/>
      <objectAnimator android:propertyName="scaleY" android:valueTo="1.08" android:duration="140" android:valueType="floatType"/>
    </set>
  </item>
  <item>
    <set>
      <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="140" android:valueType="floatType"/>
      <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="140" android:valueType="floatType"/>
    </set>
  </item>
</selector>
