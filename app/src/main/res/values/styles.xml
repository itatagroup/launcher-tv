<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Botones de la cabecera, junto a la hora. -->
  <style name="BotonCabecera">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:paddingLeft">16dp</item>
    <item name="android:paddingRight">16dp</item>
    <item name="android:paddingTop">8dp</item>
    <item name="android:paddingBottom">8dp</item>
    <item name="android:background">@drawable/boton_cabecera</item>
    <item name="android:textColor">@color/label_focus</item>
    <item name="android:textSize">@dimen/date_size</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:focusable">true</item>
    <item name="android:stateListAnimator">@null</item>
  </style>

  <style name="Section">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginLeft">@dimen/grid_inset</item>
    <item name="android:layout_marginTop">@dimen/section_margin_top</item>
    <item name="android:layout_marginBottom">@dimen/section_margin_bottom</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:textColor">@color/section</item>
    <item name="android:textSize">@dimen/section_size</item>
  </style>
  <!-- Menú de mantener OK con la paleta del inicio, no la del sistema. -->
  <style name="Menu" parent="android:Theme.Material.Dialog.Alert">
    <item name="android:colorBackgroundFloating">@color/card</item>
    <item name="android:colorBackground">@color/card</item>
    <item name="android:colorAccent">@color/accent</item>
    <item name="android:textColorPrimary">@color/clock</item>
  </style>
</resources>
